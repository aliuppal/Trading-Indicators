// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// HTF FVG Scalper — IFVG entries
// HTF FVGs (5m • 15m • 30m • 1H • 2H • 4H • Daily) • Asia / London highs & lows • Displacement
// V-Shape IFVG entries on a low timeframe (1m / 2m / 3m / 5m) • SMT vs ES • Brackets only after an HTF FVG tap
// Built for NQ1! / MNQ1! scalping. Visualization tool — not financial advice.

//@version=6
indicator("HTF FVG Scalper", shorttitle = "FVG Scalper", overlay = true, max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500, max_bars_back = 500)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════════
G_HTF = "HTF Fair Value Gaps (each TF has its own colour)"
showHtf  = input.bool(true, "Show HTF FVGs", group = G_HTF)
on5      = input.bool(true,  "5M",    inline = "t5",  group = G_HTF)
col5     = input.color(#38bdf8, "",   inline = "t5",  group = G_HTF)
on15     = input.bool(true,  "15M",   inline = "t15", group = G_HTF)
col15    = input.color(#22c55e, "",   inline = "t15", group = G_HTF)
on30     = input.bool(true,  "30M",   inline = "t30", group = G_HTF)
col30    = input.color(#eab308, "",   inline = "t30", group = G_HTF)
on60     = input.bool(true,  "1H",    inline = "t60", group = G_HTF)
col60    = input.color(#f97316, "",   inline = "t60", group = G_HTF)
on120    = input.bool(true,  "2H",    inline = "t120", group = G_HTF)
col120   = input.color(#ef4444, "",   inline = "t120", group = G_HTF)
on240    = input.bool(true,  "4H",    inline = "t240", group = G_HTF)
col240   = input.color(#a855f7, "",   inline = "t240", group = G_HTF)
onD      = input.bool(true,  "Daily", inline = "tD",  group = G_HTF)
colD     = input.color(#ec4899, "",   inline = "tD",  group = G_HTF)
htfTransp = input.int(85, "Fill transparency", minval = 0, maxval = 100, group = G_HTF)
htfMax    = input.int(3, "Max FVGs per timeframe", minval = 1, maxval = 20, group = G_HTF)
htfMitig  = input.string("Close through", "Remove FVG when", options = ["Close through", "Wick through", "Never"], group = G_HTF)

G_ENT = "IFVG Entry (low timeframe)"
showIfvg    = input.bool(true, "Show V-Shape IFVG entries", group = G_ENT)
etfIn       = input.timeframe("1", "Entry timeframe", options = ["1", "2", "3", "5"], group = G_ENT, tooltip = "Timeframe the FVG must form and invert on. Must be ≥ chart timeframe (use a 1m chart for all options).")
vBars       = input.int(15, "V-Shape: max entry-TF bars from FVG to inversion", minval = 2, maxval = 100, group = G_ENT, tooltip = "The FVG must be inverted (closed through) quickly — a V, not a grind.")
needDisp    = input.bool(true, "Require displacement on the inversion candle", group = G_ENT)
sigFilter   = input.string("All", "Show IFVG signals", options = ["All", "Only after HTF tap"], group = G_ENT)

G_BR = "Brackets (entry / SL / TP)"
showBr      = input.bool(true, "Show brackets", group = G_BR)
brNeedTap   = input.bool(true, "Only if an HTF FVG was tapped", group = G_BR, tooltip = "Longs need a recent tap of a bullish HTF FVG, shorts a bearish one.")
tapWindow   = input.int(30, "Tap valid for (chart bars)", minval = 1, maxval = 500, group = G_BR)
brSmt       = input.bool(false, "Also require SMT in the same direction", group = G_BR)
smtWindow   = input.int(20, "SMT valid for (chart bars)", minval = 1, maxval = 500, group = G_BR)
brRR        = input.float(2.0, "Take profit (R multiple)", minval = 0.5, step = 0.25, group = G_BR)
brBuffer    = input.int(4, "Stop buffer (ticks)", minval = 0, group = G_BR)
brLen       = input.int(20, "Bracket length (bars)", minval = 3, maxval = 300, group = G_BR)
brKeep      = input.int(8, "Keep last N brackets", minval = 1, maxval = 50, group = G_BR)

G_DISP = "Displacement"
showDisp  = input.bool(true, "Mark displacement candles", group = G_DISP)
dispColor = input.bool(false, "Colour displacement candles", group = G_DISP)
dispMult  = input.float(1.5, "Body ≥ ATR ×", minval = 0.5, step = 0.1, group = G_DISP)
dispRatio = input.float(0.6, "Body / range ≥", minval = 0.1, maxval = 1.0, step = 0.05, group = G_DISP)

G_SMT = "SMT Divergence"
showSmt   = input.bool(true, "Show SMT", group = G_SMT)
smtSym    = input.symbol("CME_MINI:ES1!", "SMT symbol", group = G_SMT, tooltip = "Pick the correlated market. NQ1! → ES1!, MNQ1! → MES1!.")
smtLen    = input.int(3, "Pivot length", minval = 1, group = G_SMT)
smtMaxGap = input.int(40, "Max bars between pivots", minval = 5, group = G_SMT)
smtCol    = input.color(#22d3ee, "Colour", group = G_SMT)

G_SES = "Asia / London Highs & Lows"
sesTz     = input.string("America/New_York", "Session timezone", group = G_SES)
showAsia  = input.bool(true, "", inline = "as", group = G_SES)
asiaSess  = input.session("2000-0000", "Asia", inline = "as", group = G_SES)
asiaCol   = input.color(#a78bfa, "", inline = "as", group = G_SES)
showLon   = input.bool(true, "", inline = "lo", group = G_SES)
lonSess   = input.session("0200-0500", "London", inline = "lo", group = G_SES)
lonCol    = input.color(#f472b6, "", inline = "lo", group = G_SES)
sesBox    = input.bool(false, "Shade session range", group = G_SES)
sesDays   = input.int(2, "Sessions to keep", minval = 1, maxval = 10, group = G_SES)
hideSwept = input.bool(false, "Delete levels once swept (otherwise faded)", group = G_SES)

G_UI = "Display"
showTable = input.bool(true, "Show status panel", group = G_UI)
lblSizeIn = input.string("Small", "Label size", options = ["Tiny", "Small", "Normal"], group = G_UI)
lblSize   = lblSizeIn == "Tiny" ? size.tiny : lblSizeIn == "Small" ? size.small : size.normal

// ═══════════════════════════════════════════════════════════════════════════════
// HELPERS
// ═══════════════════════════════════════════════════════════════════════════════
tfLabel(string tf) =>
    int s = timeframe.in_seconds(tf)
    s < 3600 ? str.tostring(math.round(s / 60)) + "M" : s < 86400 ? str.tostring(math.round(s / 3600)) + "H" : "D"

capBoxes(array<box> a, int n) =>
    while a.size() > n
        box.delete(a.shift())
    true

capLines(array<line> a, int n) =>
    while a.size() > n
        line.delete(a.shift())
    true

capLabels(array<label> a, int n) =>
    while a.size() > n
        label.delete(a.shift())
    true

int chartSec = timeframe.in_seconds(timeframe.period)

// ═══════════════════════════════════════════════════════════════════════════════
// HTF FAIR VALUE GAPS
// ═══════════════════════════════════════════════════════════════════════════════
type HFvg
    box    bx
    float  top
    float  bot
    bool   bull
    string txt
    bool   tapped = false

// Non-repainting: last *closed* HTF candles. Middle candle time = time[2].
htfData(string tf) =>
    request.security(syminfo.tickerid, tf, [high[1], low[1], high[3], low[3], time[2]], lookahead = barmerge.lookahead_on)

htfStep(array<HFvg> arr, string tf, bool isOn, color col, float h1, float l1, float h3, float l3, int t) =>
    bool chg     = timeframe.change(tf)
    bool enabled = showHtf and isOn and timeframe.in_seconds(tf) > chartSec
    int  ext     = chartSec * 1000 * 8
    bool bullTap = false
    bool bearTap = false
    if enabled
        if chg and not na(t)
            if l1 > h3
                string tx = tfLabel(tf) + " FVG ▲"
                arr.push(HFvg.new(box.new(t, l1, time + ext, h3, xloc = xloc.bar_time, border_color = color.new(col, 50), border_style = line.style_dashed, bgcolor = color.new(col, htfTransp), text = tx, text_size = lblSize, text_color = col, text_halign = text.align_right, text_valign = text.align_center), l1, h3, true, tx))
            if h1 < l3
                string tx = tfLabel(tf) + " FVG ▼"
                arr.push(HFvg.new(box.new(t, l3, time + ext, h1, xloc = xloc.bar_time, border_color = color.new(col, 50), border_style = line.style_dashed, bgcolor = color.new(col, htfTransp), text = tx, text_size = lblSize, text_color = col, text_halign = text.align_right, text_valign = text.align_center), l3, h1, false, tx))
            while arr.size() > htfMax
                box.delete(arr.shift().bx)
        if arr.size() > 0
            for i = arr.size() - 1 to 0
                HFvg f = arr.get(i)
                bool mitigated = htfMitig == "Close through" ? (f.bull ? close < f.bot : close > f.top) : htfMitig == "Wick through" ? (f.bull ? low < f.bot : high > f.top) : false
                if mitigated
                    box.delete(f.bx)
                    arr.remove(i)
                else
                    bool inZone = f.bull ? low <= f.top : high >= f.bot
                    if inZone
                        if f.bull
                            bullTap := true
                        else
                            bearTap := true
                        if not f.tapped
                            f.tapped := true
                            box.set_border_style(f.bx, line.style_solid)
                            box.set_border_width(f.bx, 2)
                            box.set_text(f.bx, f.txt + " • TAPPED")
                    box.set_right(f.bx, time + ext)
    [bullTap, bearTap]

[a5h1, a5l1, a5h3, a5l3, a5t]           = htfData("5")
[a15h1, a15l1, a15h3, a15l3, a15t]      = htfData("15")
[a30h1, a30l1, a30h3, a30l3, a30t]      = htfData("30")
[a60h1, a60l1, a60h3, a60l3, a60t]      = htfData("60")
[a120h1, a120l1, a120h3, a120l3, a120t] = htfData("120")
[a240h1, a240l1, a240h3, a240l3, a240t] = htfData("240")
[aDh1, aDl1, aDh3, aDl3, aDt]           = htfData("D")

var array<HFvg> f5   = array.new<HFvg>()
var array<HFvg> f15  = array.new<HFvg>()
var array<HFvg> f30  = array.new<HFvg>()
var array<HFvg> f60  = array.new<HFvg>()
var array<HFvg> f120 = array.new<HFvg>()
var array<HFvg> f240 = array.new<HFvg>()
var array<HFvg> fD   = array.new<HFvg>()

[b5, s5]     = htfStep(f5,   "5",   on5,   col5,   a5h1,   a5l1,   a5h3,   a5l3,   a5t)
[b15, s15]   = htfStep(f15,  "15",  on15,  col15,  a15h1,  a15l1,  a15h3,  a15l3,  a15t)
[b30, s30]   = htfStep(f30,  "30",  on30,  col30,  a30h1,  a30l1,  a30h3,  a30l3,  a30t)
[b60, s60]   = htfStep(f60,  "60",  on60,  col60,  a60h1,  a60l1,  a60h3,  a60l3,  a60t)
[b120, s120] = htfStep(f120, "120", on120, col120, a120h1, a120l1, a120h3, a120l3, a120t)
[b240, s240] = htfStep(f240, "240", on240, col240, a240h1, a240l1, a240h3, a240l3, a240t)
[bD, sD]     = htfStep(fD,   "D",   onD,   colD,   aDh1,   aDl1,   aDh3,   aDl3,   aDt)

string bullTapTfs = (b5 ? "5M " : "") + (b15 ? "15M " : "") + (b30 ? "30M " : "") + (b60 ? "1H " : "") + (b120 ? "2H " : "") + (b240 ? "4H " : "") + (bD ? "D " : "")
string bearTapTfs = (s5 ? "5M " : "") + (s15 ? "15M " : "") + (s30 ? "30M " : "") + (s60 ? "1H " : "") + (s120 ? "2H " : "") + (s240 ? "4H " : "") + (sD ? "D " : "")

var int    lastBullTap   = na
var int    lastBearTap   = na
var string lastBullTapTf = ""
var string lastBearTapTf = ""
if bullTapTfs != ""
    lastBullTap   := bar_index
    lastBullTapTf := str.trim(bullTapTfs)
if bearTapTfs != ""
    lastBearTap   := bar_index
    lastBearTapTf := str.trim(bearTapTfs)

bool bullTapOk = not na(lastBullTap) and bar_index - lastBullTap <= tapWindow
bool bearTapOk = not na(lastBearTap) and bar_index - lastBearTap <= tapWindow

// ═══════════════════════════════════════════════════════════════════════════════
// DISPLACEMENT (chart timeframe)
// ═══════════════════════════════════════════════════════════════════════════════
float atr14   = ta.atr(14)
float body    = math.abs(close - open)
float rng     = high - low
bool  dispUp  = close > open and body >= dispMult * atr14 and rng > 0 and body / rng >= dispRatio
bool  dispDn  = close < open and body >= dispMult * atr14 and rng > 0 and body / rng >= dispRatio

plotshape(showDisp and dispUp, "Bullish displacement", shape.triangleup, location.belowbar, color.new(#22c55e, 0), size = size.tiny)
plotshape(showDisp and dispDn, "Bearish displacement", shape.triangledown, location.abovebar, color.new(#ef4444, 0), size = size.tiny)
barcolor(dispColor and dispUp ? #22c55e : dispColor and dispDn ? #ef4444 : na)

// ═══════════════════════════════════════════════════════════════════════════════
// V-SHAPE IFVG ON THE ENTRY TIMEFRAME
// ═══════════════════════════════════════════════════════════════════════════════
// Bullish: a bearish FVG forms on the sell-off, then within `vBars` a candle CLOSES above
// the FVG top (inversion) — optionally with displacement. SL = lowest low since the FVG formed.
// Bearish is the mirror. Runs inside request.security on the entry timeframe and returns the
// result of the last *closed* entry-TF candle (no repaint).
ifvgLogic(int maxBars, float dMult, float dRatio, bool reqDisp) =>
    var array<float> bTop = array.new<float>()
    var array<float> bBot = array.new<float>()
    var array<int>   bT   = array.new<int>()
    var array<int>   bBar = array.new<int>()
    var array<float> bExt = array.new<float>()
    var array<float> uTop = array.new<float>()
    var array<float> uBot = array.new<float>()
    var array<int>   uT   = array.new<int>()
    var array<int>   uBar = array.new<int>()
    var array<float> uExt = array.new<float>()
    float a   = ta.atr(14)
    float bd  = math.abs(close - open)
    float rg  = high - low
    bool  dU  = close > open and bd >= dMult * a and rg > 0 and bd / rg >= dRatio
    bool  dD  = close < open and bd >= dMult * a and rg > 0 and bd / rg >= dRatio
    bool  longSig  = false
    bool  shortSig = false
    float zTop  = na
    float zBot  = na
    float zSl   = na
    int   zT    = na
    // Inversions of existing gaps
    if bTop.size() > 0
        for i = bTop.size() - 1 to 0
            bExt.set(i, math.min(bExt.get(i), low))
            int age = bar_index - bBar.get(i)
            if close > bTop.get(i) and age > 0 and age <= maxBars and (not reqDisp or dU)
                if not longSig
                    longSig := true
                    zTop    := bTop.get(i)
                    zBot    := bBot.get(i)
                    zSl     := bExt.get(i)
                    zT      := bT.get(i)
                bTop.remove(i)
                bBot.remove(i)
                bT.remove(i)
                bBar.remove(i)
                bExt.remove(i)
            else if age > maxBars or close > bTop.get(i)
                bTop.remove(i)
                bBot.remove(i)
                bT.remove(i)
                bBar.remove(i)
                bExt.remove(i)
    if uTop.size() > 0
        for i = uTop.size() - 1 to 0
            uExt.set(i, math.max(uExt.get(i), high))
            int age = bar_index - uBar.get(i)
            if close < uBot.get(i) and age > 0 and age <= maxBars and (not reqDisp or dD)
                if not shortSig
                    shortSig := true
                    zTop     := uTop.get(i)
                    zBot     := uBot.get(i)
                    zSl      := uExt.get(i)
                    zT       := uT.get(i)
                uTop.remove(i)
                uBot.remove(i)
                uT.remove(i)
                uBar.remove(i)
                uExt.remove(i)
            else if age > maxBars or close < uBot.get(i)
                uTop.remove(i)
                uBot.remove(i)
                uT.remove(i)
                uBar.remove(i)
                uExt.remove(i)
    // New gaps formed by this candle (middle candle = [1])
    if high < low[2]
        bTop.push(low[2])
        bBot.push(high)
        bT.push(time[1])
        bBar.push(bar_index)
        bExt.push(math.min(low, math.min(low[1], low[2])))
    if low > high[2]
        uTop.push(low)
        uBot.push(high[2])
        uT.push(time[1])
        uBar.push(bar_index)
        uExt.push(math.max(high, math.max(high[1], high[2])))
    while bTop.size() > 20
        bTop.shift()
        bBot.shift()
        bT.shift()
        bBar.shift()
        bExt.shift()
    while uTop.size() > 20
        uTop.shift()
        uBot.shift()
        uT.shift()
        uBar.shift()
        uExt.shift()
    [longSig[1], shortSig[1], zTop[1], zBot[1], zSl[1], zT[1], close[1], time[1]]

string etf = timeframe.in_seconds(etfIn) < chartSec ? timeframe.period : etfIn
bool etfWarn = timeframe.in_seconds(etfIn) < chartSec

[eLong, eShort, eTop, eBot, eSl, eT, eEntry, eSigT] = request.security(syminfo.tickerid, etf, ifvgLogic(vBars, dispMult, dispRatio, needDisp), lookahead = barmerge.lookahead_on)
bool etfNew   = timeframe.change(etf)
bool longIfvg  = showIfvg and etfNew and eLong
bool shortIfvg = showIfvg and etfNew and eShort

// ═══════════════════════════════════════════════════════════════════════════════
// SMT DIVERGENCE (vs user-selected symbol, default ES)
// ═══════════════════════════════════════════════════════════════════════════════
[h2, l2] = request.security(smtSym, timeframe.period, [high, low], ignore_invalid_symbol = true)
sPH    = ta.pivothigh(high, smtLen, smtLen)
sPL    = ta.pivotlow(low, smtLen, smtLen)
win2Hi = ta.highest(h2, 2 * smtLen + 1)
win2Lo = ta.lowest(l2, 2 * smtLen + 1)

var array<line>  smtLines  = array.new<line>()
var array<label> smtLabels = array.new<label>()
var float pSH = na
var int   pSHBar = na
var float pSH2 = na
var float pSL = na
var int   pSLBar = na
var float pSL2 = na
var int   lastBullSmt = na
var int   lastBearSmt = na
bool bearSmt = false
bool bullSmt = false
array<string> smtParts = str.split(smtSym, ":")
string smtName = smtParts.size() > 1 ? smtParts.get(1) : smtSym

if not na(sPH)
    int b = bar_index - smtLen
    if showSmt and not na(pSH) and not na(pSH2) and not na(win2Hi) and b - pSHBar <= smtMaxGap
        bearSmt := (sPH > pSH and win2Hi <= pSH2) or (sPH <= pSH and win2Hi > pSH2)
        if bearSmt
            lastBearSmt := bar_index
            smtLines.push(line.new(pSHBar, pSH, b, sPH, color = smtCol, width = 2))
            smtLabels.push(label.new(b, sPH, "SMT", style = label.style_label_down, color = color.new(smtCol, 75), textcolor = smtCol, size = lblSize, tooltip = "Bearish SMT vs " + smtName))
    pSH    := sPH
    pSHBar := b
    pSH2   := win2Hi

if not na(sPL)
    int b = bar_index - smtLen
    if showSmt and not na(pSL) and not na(pSL2) and not na(win2Lo) and b - pSLBar <= smtMaxGap
        bullSmt := (sPL < pSL and win2Lo >= pSL2) or (sPL >= pSL and win2Lo < pSL2)
        if bullSmt
            lastBullSmt := bar_index
            smtLines.push(line.new(pSLBar, pSL, b, sPL, color = smtCol, width = 2))
            smtLabels.push(label.new(b, sPL, "SMT", style = label.style_label_up, color = color.new(smtCol, 75), textcolor = smtCol, size = lblSize, tooltip = "Bullish SMT vs " + smtName))
    pSL    := sPL
    pSLBar := b
    pSL2   := win2Lo

capLines(smtLines, 20)
capLabels(smtLabels, 20)

bool bullSmtOk = not na(lastBullSmt) and bar_index - lastBullSmt <= smtWindow
bool bearSmtOk = not na(lastBearSmt) and bar_index - lastBearSmt <= smtWindow

// ═══════════════════════════════════════════════════════════════════════════════
// IFVG SIGNALS & BRACKETS
// ═══════════════════════════════════════════════════════════════════════════════
var array<box>   sigBoxes  = array.new<box>()
var array<label> sigLabels = array.new<label>()
var array<box>   brBoxes   = array.new<box>()
var array<line>  brLines   = array.new<line>()

bool showLongSig  = longIfvg and (sigFilter == "All" or bullTapOk)
bool showShortSig = shortIfvg and (sigFilter == "All" or bearTapOk)
bool longSetup    = showLongSig and (not brNeedTap or bullTapOk) and (not brSmt or bullSmtOk)
bool shortSetup   = showShortSig and (not brNeedTap or bearTapOk) and (not brSmt or bearSmtOk)

float buf = brBuffer * syminfo.mintick
string etfLbl = tfLabel(etf)

if showLongSig
    sigBoxes.push(box.new(eT, eTop, time, eBot, xloc = xloc.bar_time, border_color = color.new(#22c55e, 30), bgcolor = color.new(#22c55e, 80), text = etfLbl + " V-IFVG ▲", text_size = size.tiny, text_color = #22c55e, text_halign = text.align_left, text_valign = text.align_bottom))
    sigLabels.push(label.new(eSigT, eBot, "▲ IFVG" + (bullTapOk ? "\n" + lastBullTapTf + " tap" : ""), xloc = xloc.bar_time, style = label.style_label_up, color = color.new(#22c55e, 20), textcolor = color.white, size = lblSize))
if showShortSig
    sigBoxes.push(box.new(eT, eTop, time, eBot, xloc = xloc.bar_time, border_color = color.new(#ef4444, 30), bgcolor = color.new(#ef4444, 80), text = etfLbl + " V-IFVG ▼", text_size = size.tiny, text_color = #ef4444, text_halign = text.align_left, text_valign = text.align_top))
    sigLabels.push(label.new(eSigT, eTop, "▼ IFVG" + (bearTapOk ? "\n" + lastBearTapTf + " tap" : ""), xloc = xloc.bar_time, style = label.style_label_down, color = color.new(#ef4444, 20), textcolor = color.white, size = lblSize))

float lEntry = eEntry
float lSl    = eSl - buf
float lTp    = lEntry + brRR * (lEntry - lSl)
float sEntry = eEntry
float sSl    = eSl + buf
float sTp    = sEntry - brRR * (sSl - sEntry)

if showBr and longSetup and lEntry > lSl
    brBoxes.push(box.new(bar_index, lTp, bar_index + brLen, lEntry, border_color = color.new(#22c55e, 50), bgcolor = color.new(#22c55e, 85), text = "TP " + str.tostring(lTp, format.mintick), text_size = size.tiny, text_color = #22c55e, text_halign = text.align_right, text_valign = text.align_top))
    brBoxes.push(box.new(bar_index, lEntry, bar_index + brLen, lSl, border_color = color.new(#ef4444, 50), bgcolor = color.new(#ef4444, 85), text = "SL " + str.tostring(lSl, format.mintick), text_size = size.tiny, text_color = #ef4444, text_halign = text.align_right, text_valign = text.align_bottom))
    brLines.push(line.new(bar_index, lEntry, bar_index + brLen, lEntry, color = chart.fg_color, width = 2))
if showBr and shortSetup and sSl > sEntry
    brBoxes.push(box.new(bar_index, sEntry, bar_index + brLen, sTp, border_color = color.new(#22c55e, 50), bgcolor = color.new(#22c55e, 85), text = "TP " + str.tostring(sTp, format.mintick), text_size = size.tiny, text_color = #22c55e, text_halign = text.align_right, text_valign = text.align_bottom))
    brBoxes.push(box.new(bar_index, sSl, bar_index + brLen, sEntry, border_color = color.new(#ef4444, 50), bgcolor = color.new(#ef4444, 85), text = "SL " + str.tostring(sSl, format.mintick), text_size = size.tiny, text_color = #ef4444, text_halign = text.align_right, text_valign = text.align_top))
    brLines.push(line.new(bar_index, sEntry, bar_index + brLen, sEntry, color = chart.fg_color, width = 2))

capBoxes(sigBoxes, 30)
capLabels(sigLabels, 30)
capBoxes(brBoxes, brKeep * 2)
capLines(brLines, brKeep)

// ═══════════════════════════════════════════════════════════════════════════════
// ASIA / LONDON HIGHS & LOWS
// ═══════════════════════════════════════════════════════════════════════════════
type Lvl
    line  ln
    label lb
    float price
    bool  isHigh
    color col
    bool  live = true

type Sess
    bool  active = false
    float hi
    float lo
    int   hiBar
    int   loBar
    box   bx

var array<Lvl> sesLvls  = array.new<Lvl>()
var array<box> sesBoxes = array.new<box>()
var Sess asiaS = Sess.new()
var Sess lonS  = Sess.new()

newLvl(array<Lvl> arr, int x, float p, string txt, color col, bool isHigh) =>
    line  ln = line.new(x, p, bar_index + 3, p, color = col, width = 1)
    label lb = label.new(bar_index + 3, p, txt, style = label.style_label_left, color = color.new(col, 80), textcolor = col, size = size.tiny)
    arr.push(Lvl.new(ln, lb, p, isHigh, col))

updLvls(array<Lvl> arr) =>
    bool sh = false
    bool sl = false
    for lv in arr
        if lv.live
            if (lv.isHigh and high > lv.price) or (not lv.isHigh and low < lv.price)
                lv.live := false
                if lv.isHigh
                    sh := true
                else
                    sl := true
                if hideSwept
                    line.delete(lv.ln)
                    label.delete(lv.lb)
                else
                    line.set_x2(lv.ln, bar_index)
                    line.set_style(lv.ln, line.style_dotted)
                    line.set_color(lv.ln, color.new(lv.col, 50))
                    label.set_x(lv.lb, bar_index)
                    label.set_textcolor(lv.lb, color.new(lv.col, 50))
                    label.set_color(lv.lb, color.new(lv.col, 92))
            else
                line.set_x2(lv.ln, bar_index + 3)
                label.set_x(lv.lb, bar_index + 3)
    [sh, sl]

sesStep(Sess st, bool enabled, string sess, string name, color col) =>
    bool inS = not na(time(timeframe.period, sess, sesTz))
    if enabled
        if inS
            if not st.active
                st.active := true
                st.hi     := high
                st.lo     := low
                st.hiBar  := bar_index
                st.loBar  := bar_index
                st.bx     := na
                if sesBox
                    st.bx := box.new(bar_index, high, bar_index, low, border_color = color.new(col, 60), bgcolor = color.new(col, 92), text = name, text_size = size.tiny, text_color = col, text_halign = text.align_left, text_valign = text.align_top)
                    sesBoxes.push(st.bx)
            else
                if high > st.hi
                    st.hi    := high
                    st.hiBar := bar_index
                if low < st.lo
                    st.lo    := low
                    st.loBar := bar_index
            if not na(st.bx)
                box.set_top(st.bx, st.hi)
                box.set_bottom(st.bx, st.lo)
                box.set_right(st.bx, bar_index)
        else if st.active
            st.active := false
            newLvl(sesLvls, st.hiBar, st.hi, name + " H", col, true)
            newLvl(sesLvls, st.loBar, st.lo, name + " L", col, false)
    true

[sesSweptH, sesSweptL] = updLvls(sesLvls)
sesStep(asiaS, showAsia and timeframe.isintraday, asiaSess, "ASIA", asiaCol)
sesStep(lonS,  showLon and timeframe.isintraday,  lonSess,  "LONDON", lonCol)
while sesLvls.size() > sesDays * 4
    Lvl old = sesLvls.shift()
    line.delete(old.ln)
    label.delete(old.lb)
capBoxes(sesBoxes, sesDays * 2)

// ═══════════════════════════════════════════════════════════════════════════════
// STATUS PANEL
// ═══════════════════════════════════════════════════════════════════════════════
var table panel = table.new(position.top_right, 2, 5, bgcolor = color.new(#0b0f14, 15), border_width = 1, border_color = color.new(#334155, 50))
if showTable and barstate.islast
    color txtC = #e5e7eb
    table.cell(panel, 0, 0, "Entry TF", text_color = color.gray, text_size = size.small)
    table.cell(panel, 1, 0, etfLbl + (etfWarn ? "  ⚠ lower chart TF" : ""), text_color = etfWarn ? #f59e0b : txtC, text_size = size.small)
    table.cell(panel, 0, 1, "Bull HTF tap", text_color = color.gray, text_size = size.small)
    table.cell(panel, 1, 1, bullTapOk ? lastBullTapTf + " (" + str.tostring(bar_index - lastBullTap) + " bars)" : "—", text_color = bullTapOk ? #22c55e : txtC, text_size = size.small)
    table.cell(panel, 0, 2, "Bear HTF tap", text_color = color.gray, text_size = size.small)
    table.cell(panel, 1, 2, bearTapOk ? lastBearTapTf + " (" + str.tostring(bar_index - lastBearTap) + " bars)" : "—", text_color = bearTapOk ? #ef4444 : txtC, text_size = size.small)
    table.cell(panel, 0, 3, "SMT vs", text_color = color.gray, text_size = size.small)
    table.cell(panel, 1, 3, smtName + (bullSmtOk ? "  ▲ bull" : bearSmtOk ? "  ▼ bear" : ""), text_color = smtCol, text_size = size.small)
    table.cell(panel, 0, 4, "Brackets", text_color = color.gray, text_size = size.small)
    table.cell(panel, 1, 4, brNeedTap ? "after HTF tap only" : "always", text_color = txtC, text_size = size.small)

// ═══════════════════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════════════════
if longSetup
    alert("LONG V-IFVG (" + etfLbl + ") on " + syminfo.ticker + " | Entry " + str.tostring(lEntry, format.mintick) + " SL " + str.tostring(lSl, format.mintick) + " TP " + str.tostring(lTp, format.mintick) + " | HTF tap: " + lastBullTapTf, alert.freq_once_per_bar)
if shortSetup
    alert("SHORT V-IFVG (" + etfLbl + ") on " + syminfo.ticker + " | Entry " + str.tostring(sEntry, format.mintick) + " SL " + str.tostring(sSl, format.mintick) + " TP " + str.tostring(sTp, format.mintick) + " | HTF tap: " + lastBearTapTf, alert.freq_once_per_bar)

alertcondition(longSetup, "Long V-IFVG setup", "Long V-IFVG setup on {{ticker}}")
alertcondition(shortSetup, "Short V-IFVG setup", "Short V-IFVG setup on {{ticker}}")
alertcondition(longIfvg, "Any bullish IFVG", "Bullish IFVG on {{ticker}}")
alertcondition(shortIfvg, "Any bearish IFVG", "Bearish IFVG on {{ticker}}")
alertcondition(bullTapTfs != "", "Bullish HTF FVG tapped", "Bullish HTF FVG tapped on {{ticker}}")
alertcondition(bearTapTfs != "", "Bearish HTF FVG tapped", "Bearish HTF FVG tapped on {{ticker}}")
alertcondition(bullSmt, "Bullish SMT", "Bullish SMT on {{ticker}}")
alertcondition(bearSmt, "Bearish SMT", "Bearish SMT on {{ticker}}")
alertcondition(sesSweptH, "Asia/London high swept", "Session high swept on {{ticker}}")
alertcondition(sesSweptL, "Asia/London low swept", "Session low swept on {{ticker}}")
