// Session Liquidity Levels
// Asia / London / NY AM / NY PM highs & lows (AS.H, LO.L, NYAM.H, NYPM.L …) extended until taken
// Key opens: True Day Open, 8:30, 9:30, 10:00 • PDH / PDL • Nearest BSL / SSL
// Visualization tool — not financial advice.

//@version=6
indicator("Session Liquidity Levels", shorttitle = "Session Levels", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 200)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════════
tz = input.string("America/New_York", "Timezone", group = "General", tooltip = "Timezone the session and open times are written in.")

G_SES = "Sessions (high / low)"
asOn   = input.bool(true, "", inline = "as", group = G_SES)
asSess = input.session("2000-0000", "Asia (AS)", inline = "as", group = G_SES)
asCol  = input.color(#2962ff, "", inline = "as", group = G_SES)
loOn   = input.bool(true, "", inline = "lo", group = G_SES)
loSess = input.session("0200-0500", "London (LO)", inline = "lo", group = G_SES)
loCol  = input.color(#26a69a, "", inline = "lo", group = G_SES)
amOn   = input.bool(true, "", inline = "am", group = G_SES)
amSess = input.session("0930-1200", "NY AM (NYAM)", inline = "am", group = G_SES)
amCol  = input.color(#ff9800, "", inline = "am", group = G_SES)
pmOn   = input.bool(true, "", inline = "pm", group = G_SES)
pmSess = input.session("1330-1600", "NY PM (NYPM)", inline = "pm", group = G_SES)
pmCol  = input.color(#fdd835, "", inline = "pm", group = G_SES)
sesBox    = input.bool(false, "Shade session ranges", group = G_SES)
sweptMode = input.string("Stop at sweep", "When a level is taken", options = ["Stop at sweep", "Delete"], group = G_SES)
lineW     = input.int(2, "Line width", minval = 1, maxval = 4, group = G_SES)
keepDays  = input.int(3, "Days to keep", minval = 1, maxval = 20, group = G_SES)

G_OPEN = "Opens"
tdoOn  = input.bool(true, "True Day Open", inline = "o1", group = G_OPEN)
tdoH   = input.int(0, "", minval = 0, maxval = 23, inline = "o1", group = G_OPEN)
tdoM   = input.int(0, ":", minval = 0, maxval = 59, inline = "o1", group = G_OPEN)
o830On = input.bool(true, "8:30 Open", inline = "o2", group = G_OPEN)
o830H  = input.int(8, "", minval = 0, maxval = 23, inline = "o2", group = G_OPEN)
o830M  = input.int(30, ":", minval = 0, maxval = 59, inline = "o2", group = G_OPEN)
o930On = input.bool(true, "9:30 Open", inline = "o3", group = G_OPEN)
o930H  = input.int(9, "", minval = 0, maxval = 23, inline = "o3", group = G_OPEN)
o930M  = input.int(30, ":", minval = 0, maxval = 59, inline = "o3", group = G_OPEN)
o10On  = input.bool(true, "10am Open", inline = "o4", group = G_OPEN)
o10H   = input.int(10, "", minval = 0, maxval = 23, inline = "o4", group = G_OPEN)
o10M   = input.int(0, ":", minval = 0, maxval = 59, inline = "o4", group = G_OPEN)
openCol = input.color(#787b86, "Open line colour", group = G_OPEN)

G_PD = "Previous Day & Liquidity"
pdOn   = input.bool(true, "PDH / PDL", inline = "pd", group = G_PD)
pdCol  = input.color(#9c27b0, "", inline = "pd", group = G_PD)
bslSsl = input.bool(true, "Mark nearest BSL / SSL", group = G_PD, tooltip = "Labels the closest untaken level above price as BSL (buy-side liquidity) and below price as SSL (sell-side liquidity).")

G_UI = "Labels"
lblColIn  = input.color(#787b86, "Label text colour", group = G_UI)
lblSizeIn = input.string("Small", "Label size", options = ["Tiny", "Small", "Normal"], group = G_UI)
lblSize   = lblSizeIn == "Tiny" ? size.tiny : lblSizeIn == "Small" ? size.small : size.normal

// ═══════════════════════════════════════════════════════════════════════════════
// TYPES
// ═══════════════════════════════════════════════════════════════════════════════
type Lvl
    line   ln
    label  lb
    float  price
    bool   isHigh
    string tag
    bool   live = true

type Sess
    bool  active = false
    float hi
    float lo
    int   hiBar
    int   loBar
    box   bx

type OpenLv
    line  ln
    label lb
    bool  active = true

var array<Lvl>    levels   = array.new<Lvl>()
var array<box>    sesBoxes = array.new<box>()
var array<OpenLv> opens1   = array.new<OpenLv>()
var array<OpenLv> opens2   = array.new<OpenLv>()
var array<OpenLv> opens3   = array.new<OpenLv>()
var array<OpenLv> opens4   = array.new<OpenLv>()
var Sess asS = Sess.new()
var Sess loS = Sess.new()
var Sess amS = Sess.new()
var Sess pmS = Sess.new()

bool intraday = timeframe.isintraday
bool newDay   = timeframe.change("D")

// ═══════════════════════════════════════════════════════════════════════════════
// LEVELS (session highs/lows, PDH/PDL)
// ═══════════════════════════════════════════════════════════════════════════════
addLevel(int x, float p, string tag, color col, bool isHigh) =>
    line  ln = line.new(x, p, bar_index, p, color = col, width = lineW)
    label lb = label.new(x, p, tag, style = isHigh ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = lblColIn, size = lblSize)
    levels.push(Lvl.new(ln, lb, p, isHigh, tag))
    while levels.size() > keepDays * 10
        Lvl old = levels.shift()
        line.delete(old.ln)
        label.delete(old.lb)

// Extend untaken levels; stop (or delete) them once price trades through
bool anyHighTaken = false
bool anyLowTaken  = false
for lv in levels
    if lv.live
        bool taken = lv.isHigh ? high > lv.price : low < lv.price
        if taken
            lv.live := false
            if lv.isHigh
                anyHighTaken := true
            else
                anyLowTaken := true
            if sweptMode == "Delete"
                line.delete(lv.ln)
                label.delete(lv.lb)
            else
                line.set_x2(lv.ln, bar_index)
        else
            line.set_x2(lv.ln, bar_index)

sesStep(Sess st, bool enabled, string sess, string tag, color col) =>
    bool inS = not na(time(timeframe.period, sess, tz))
    if enabled and intraday
        if inS
            if not st.active
                st.active := true
                st.hi     := high
                st.lo     := low
                st.hiBar  := bar_index
                st.loBar  := bar_index
                st.bx     := na
                if sesBox
                    st.bx := box.new(bar_index, high, bar_index, low, border_color = color.new(col, 70), bgcolor = color.new(col, 92))
                    sesBoxes.push(st.bx)
                    while sesBoxes.size() > keepDays * 4
                        box.delete(sesBoxes.shift())
            else
                if high > st.hi
                    st.hi    := high
                    st.hiBar := bar_index
                if low < st.lo
                    st.lo    := low
                    st.loBar := bar_index
            if not na(st.bx)
                box.set_top(st.bx, st.hi)
                box.set_bottom(st.bx, st.lo)
                box.set_right(st.bx, bar_index)
        else if st.active
            st.active := false
            addLevel(st.hiBar, st.hi, tag + ".H", col, true)
            addLevel(st.loBar, st.lo, tag + ".L", col, false)
    true

sesStep(asS, asOn, asSess, "AS",   asCol)
sesStep(loS, loOn, loSess, "LO",   loCol)
sesStep(amS, amOn, amSess, "NYAM", amCol)
sesStep(pmS, pmOn, pmSess, "NYPM", pmCol)

// Previous day high / low
var float dHi = na
var float dLo = na
var int   dHiBar = na
var int   dLoBar = na
var int   dayCount = 0
if newDay
    dayCount += 1
    if pdOn and intraday and dayCount >= 2 and not na(dHi)
        addLevel(dHiBar, dHi, "PDH", pdCol, true)
        addLevel(dLoBar, dLo, "PDL", pdCol, false)
    dHi    := high
    dLo    := low
    dHiBar := bar_index
    dLoBar := bar_index
else
    if na(dHi) or high > dHi
        dHi    := high
        dHiBar := bar_index
    if na(dLo) or low < dLo
        dLo    := low
        dLoBar := bar_index

// ═══════════════════════════════════════════════════════════════════════════════
// OPENS (True Day Open, 8:30, 9:30, 10:00)
// ═══════════════════════════════════════════════════════════════════════════════
openStep(array<OpenLv> arr, bool on, int hh, int mm, string txt) =>
    bool hit = on and intraday and hour(time, tz) == hh and minute(time, tz) == mm
    // stop extending yesterday's opens when a new trading day starts
    if newDay and not hit
        for o in arr
            o.active := false
    if hit
        for o in arr
            o.active := false
        line  ln = line.new(bar_index, open, bar_index + 5, open, color = openCol, style = line.style_dotted, width = 1)
        label lb = label.new(bar_index + 5, open, txt, style = label.style_label_left, color = color.new(color.black, 100), textcolor = lblColIn, size = lblSize)
        arr.push(OpenLv.new(ln, lb))
        while arr.size() > keepDays
            OpenLv old = arr.shift()
            line.delete(old.ln)
            label.delete(old.lb)
    for o in arr
        if o.active
            line.set_x2(o.ln, bar_index + 5)
            label.set_x(o.lb, bar_index + 5)
    hit

bool tdoHit = openStep(opens1, tdoOn, tdoH, tdoM, "True Day Open")
bool o830Hit = openStep(opens2, o830On, o830H, o830M, "8:30 Open")
bool o930Hit = openStep(opens3, o930On, o930H, o930M, "9:30")
bool o10Hit  = openStep(opens4, o10On, o10H, o10M, "10am open")

// ═══════════════════════════════════════════════════════════════════════════════
// NEAREST BSL / SSL
// ═══════════════════════════════════════════════════════════════════════════════
var label bslLbl = na
var label sslLbl = na
var line  bslLn  = na
var line  sslLn  = na
if barstate.islast
    label.delete(bslLbl)
    label.delete(sslLbl)
    line.delete(bslLn)
    line.delete(sslLn)
    if bslSsl
        Lvl up = na
        Lvl dn = na
        for lv in levels
            if lv.live
                if lv.isHigh and lv.price > close and (na(up) or lv.price < up.price)
                    up := lv
                if not lv.isHigh and lv.price < close and (na(dn) or lv.price > dn.price)
                    dn := lv
        if not na(up)
            bslLn  := line.new(bar_index, up.price, bar_index + 12, up.price, color = chart.fg_color, width = 1)
            bslLbl := label.new(bar_index + 12, up.price, "BSL · " + up.tag, style = label.style_label_left, color = color.new(color.black, 100), textcolor = chart.fg_color, size = size.normal)
        if not na(dn)
            sslLn  := line.new(bar_index, dn.price, bar_index + 12, dn.price, color = chart.fg_color, width = 1)
            sslLbl := label.new(bar_index + 12, dn.price, "SSL · " + dn.tag, style = label.style_label_left, color = color.new(color.black, 100), textcolor = chart.fg_color, size = size.normal)

// ═══════════════════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════════════════
alertcondition(anyHighTaken, "Session/PD high taken", "A session or previous-day HIGH was taken on {{ticker}}")
alertcondition(anyLowTaken, "Session/PD low taken", "A session or previous-day LOW was taken on {{ticker}}")
alertcondition(tdoHit, "True Day Open", "True Day Open on {{ticker}}")
alertcondition(o930Hit, "9:30 Open", "9:30 open on {{ticker}}")
